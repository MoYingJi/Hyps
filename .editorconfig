root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[tools/xwin-watch/protocols/*.xml]
indent_style = space
indent_size = 2

[tools/xwin-watch/generated/*.{c,h}]
indent_style = tab
indent_size = 8
tab_width = 8
